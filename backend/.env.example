PORT=3001

# Turso (base de datos remota SQLite)
TURSO_DATABASE_URL=libsql://tu-database-org.turso.io
TURSO_AUTH_TOKEN=tu_token

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=tu_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id
WHATSAPP_VERIFY_TOKEN=solventa_wsp_secret
# App Secret de tu app de Meta (Meta for Developers → tu app → Settings →
# Basic → App Secret). Verifica que los mensajes del webhook vengan
# realmente de Meta, no de cualquiera que fabrique el POST.
META_APP_SECRET=

# IA Opcional para procesamiento inteligente de lenguaje
GEMINI_API_KEY=tu_gemini_api_key

# Seguridad: login con contraseña (cookie de sesión httpOnly).
# JWT_SECRET firma la sesión, genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# AUTH_PASSWORD_HASH es el hash bcrypt de tu contraseña de acceso, genera con:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 10))" "tu_contraseña"
AUTH_PASSWORD_HASH=

# Seguridad: solo se procesan mensajes de WhatsApp de este número (formato
# internacional sin "+", ej: 51987654321). Vacío = no restringe.
WHATSAPP_OWNER_NUMBER=

# Seguridad: lista EXACTA de orígenes (separados por coma) autorizados a
# llamar a la API desde el navegador, además de localhost. Sin comodines
# *.vercel.app (cualquiera puede registrar un proyecto con nombre parecido).
# Ej: ALLOWED_ORIGINS=https://solventa-app.vercel.app,https://solventa.tudominio.com
ALLOWED_ORIGINS=
