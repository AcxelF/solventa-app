PORT=3001

# Turso (base de datos remota SQLite)
TURSO_DATABASE_URL=libsql://tu-database-org.turso.io
TURSO_AUTH_TOKEN=tu_token

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=tu_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id
WHATSAPP_VERIFY_TOKEN=solventa_wsp_secret

# IA Opcional para procesamiento inteligente de lenguaje
GEMINI_API_KEY=tu_gemini_api_key

# Seguridad: clave secreta que debe mandar el frontend en cada request
# (header Authorization: Bearer <API_KEY>). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Debe ser idéntica a VITE_API_KEY en frontend/.env.
API_KEY=

# Seguridad: solo se procesan mensajes de WhatsApp de este número (formato
# internacional sin "+", ej: 51987654321). Vacío = no restringe.
WHATSAPP_OWNER_NUMBER=

# Seguridad: dominios adicionales (separados por coma) autorizados a llamar
# a la API desde el navegador. localhost y *.vercel.app siempre se permiten.
ALLOWED_ORIGINS=
