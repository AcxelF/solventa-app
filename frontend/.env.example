# Variable de entorno de Vite para la URL base de la API del backend.
# En Vite, las variables expuestas al frontend deben llevar el prefijo VITE_.
#
# Si NO defines esta variable, el frontend usará por defecto:
#   http://localhost:3001/api   (backend local en desarrollo)
#
# En producción (despliegue de Vercel), define aquí la URL pública del
# backend desplegado en Render:
VITE_API_URL=https://solventa-backend-27cr.onrender.com/api

# Seguridad: debe ser idéntica al API_KEY del backend (backend/.env). Sin
# esto, cada request a la API se manda sin el header Authorization.
VITE_API_KEY=
